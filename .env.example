# Leave empty to run in demo mode (deterministic stand-in, no billed calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Optional operator key for mutating routes.
DIWAN_API_KEY=

CORS_ORIGINS=http://localhost:8000
RATE_LIMIT_PER_MINUTE=30
MAX_QUERY_LENGTH=4000
MAX_UPLOAD_BYTES=2097152

INDEX_DIR=data/index
DATABASE_PATH=data/diwan.db
KNOWLEDGE_DIR=data/knowledge
